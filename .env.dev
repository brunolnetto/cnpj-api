# Possible values: development, staging, production
ENVIRONMENT=development

# Database Information
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME_RFB="dadosrfb_dev"
POSTGRES_DBNAME_AUDIT="dadosrfb_analysis"

# Default values for ate limit 
DEFAULT_RATE_LIMIT="10/minute"
DEFAULT_BURST_RATE_LIMIT="500/hour"

# Origin Cross-Origin Resource Sharing
BACKEND_CORS_ORIGINS="http://localhost,https://localhost"

# Never reuse this value outside local development.
# Generate a real key with: openssl rand -hex 32
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256


