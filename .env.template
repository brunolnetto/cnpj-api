# Possible values: development, staging, production
ENVIRONMENT=development

# Database Information
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DBNAME_RFB="dadosrfb"
POSTGRES_DBNAME_AUDIT="dadosrfb_analysis"

# Default values for ate limit 
DEFAULT_RATE_LIMIT="10/minute"
DEFAULT_BURST_RATE_LIMIT="500/hour"

# Rate limit counters: "memory://" is per process; with several replicas use a
# shared store, e.g. redis://redis:6379 (requires the redis package)
RATE_LIMIT_STORAGE_URI=memory://

# Proxies whose X-Forwarded-For header uvicorn trusts (IPs or CIDRs)
FORWARDED_ALLOW_IPS=127.0.0.1

# Origin Cross-Origin Resource Sharing
BACKEND_CORS_ORIGINS="http://localhost,https://localhost"

JWT_SECRET_KEY=Ssecret_shhh123
JWT_ALGORITHM=HS256


